# Environment Variables Template for AI Signal Intelligence Engine
# Copy this file to .env and populate with your own genuine API credentials.
# NEVER commit the active .env file or real credentials to version control.

# ==============================================================================
# 1. APPLICATION ENVIRONMENT
# ==============================================================================
APP_ENV=development                       # development | staging | production
LOG_LEVEL=INFO                            # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json                           # json | console
DATA_DIR=data                             # Base directory for raw/processed artifacts
EXPORTS_DIR=data/exports                  # Directory for generated Excel/CSV files

# ==============================================================================
# 2. CONCURRENCY & RATE LIMITING
# ==============================================================================
MAX_CONCURRENT_REQUESTS=10                # Global HTTP concurrency cap
REQUEST_TIMEOUT_SECONDS=30                # Default HTTP timeout
POLITE_DELAY_MIN_MS=250                   # Minimum randomized jitter delay
POLITE_DELAY_MAX_MS=750                   # Maximum randomized jitter delay
USER_AGENT=AISignalIntelligenceBot/1.0 (+https://ai-signal.internal/bot; research@ai-signal.internal)

# ==============================================================================
# 3. LLM EXTRACTION ENGINE CREDENTIALS
# ==============================================================================
# Primary Provider: Gemini Flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Fallback 1: Groq Llama
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback 2: DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# LLM Fallback Configuration
LLM_MAX_RETRIES=4
LLM_INITIAL_BACKOFF_SECONDS=2.0
LLM_MAX_BACKOFF_SECONDS=30.0

# ==============================================================================
# 4. EXTERNAL APIS & INTEGRATIONS
# ==============================================================================
# GitHub REST API (for Research Paper repository star metrics)
GITHUB_TOKEN=                             # Personal Access Token (PAT) for rate limit expansion (5000 req/hr)

# Google Sheets API (for automated publishing)
GOOGLE_SHEETS_CREDENTIALS_JSON=           # Path to service_account.json
GOOGLE_SHEETS_SPREADSHEET_ID=             # Target Google Sheet ID

# ==============================================================================
# 5. STORAGE & DATABASE
# ==============================================================================
DATABASE_URL=sqlite+aiosqlite:///data/ai_signal.db  # Dev default; production: postgresql+asyncpg://user:pass@localhost:5432/ai_signal
REDIS_URL=redis://localhost:6379/0                  # Optional task queue & deduplication cache
